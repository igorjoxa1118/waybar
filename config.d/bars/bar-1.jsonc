{
  "include": [
    /*Left modules*/
    "~/.config/waybar/config.d/apps/custom-launcher.jsonc",
    "~/.config/waybar/config.d/misc/separator.jsonc",
    "~/.config/waybar/config.d/misc/wallpapers.jsonc",
    "~/.config/waybar/config.d/system/system-modules.jsonc",
    "~/.config/waybar/config.d/system/vpn-status.jsonc",
    /*Center modules*/
    "~/.config/waybar/config.d/media/pipewire-volume.jsonc",
    "~/.config/waybar/config.d/media/pulseaudio.jsonc",
    "~/.config/waybar/config.d/media/custom-cava.jsonc",
    "~/.config/waybar/config.d/system/backlight.jsonc",
    /*Right modules*/
    "~/.config/waybar/config.d/system/network.jsonc",
    "~/.config/waybar/config.d/system/net-speed.jsonc",
    /*"~/.config/waybar/config.d/hyprland/hyprshade.jsonc",*/
    "~/.config/waybar/config.d/system/battery.jsonc",
    "~/.config/waybar/config.d/hyprland/hyprland-language.jsonc",
    "~/.config/waybar/config.d/misc/tray.jsonc",
    "~/.config/waybar/config.d/misc/clock.jsonc",
    "~/.config/waybar/config.d/apps/custom-power.jsonc"
  ],
  "modules-left": [
    "custom/launcher",
    "custom/separator2",
    "cpu",
    "custom/separator2",
    "custom/gpu-temp",
    "custom/separator2",
    "custom/gpu-usage",
    "custom/separator2",
    "memory",
    "custom/separator2",
    "custom/diskusage",
    "custom/separator2",
    "custom/updates_icon",
    "custom/updates_count",
    "custom/separator2",
    "custom/wall"
  ],
  "modules-center": [
    "pulseaudio",
    "custom/separator2",
    "custom/cava",
    "custom/separator2",
    "backlight"
  ],
  "modules-right": [
    "network",
    "custom/separator2",
    "custom/netspeed",
    "custom/separator2",
    "hyprland/language",
    "custom/separator2",
    "battery",
    "custom/separator2",
    "tray",
    "custom/separator2",
    "custom/rofi-calendar",
    "clock",
    "custom/separator2",
    "custom/powermenu"
  ]
}